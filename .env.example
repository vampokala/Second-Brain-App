# Host vault path mounted into API container at /vault
VAULT_HOST_PATH=/Users/vamshipokala/Documents/Second-Brain

# Postgres
POSTGRES_PASSWORD=localdev
# Host port for the Postgres container (container-side stays 5432).
# Default is 5433 to avoid colliding with a local Homebrew Postgres on 5432.
POSTGRES_HOST_PORT=5433

# Vector backend
VECTOR_BACKEND=pgvector

# Ollama
OLLAMA_KEEP_ALIVE=5m
LLM_DEFAULT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Resource controls
MAX_INGEST_WORKERS=2
WATCHER_DEBOUNCE_MS=5000

# Provider keys (optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AI...
# GROQ_API_KEY=gsk_...
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=second-brain-app
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Hugging Face access token (optional). Required only for gated/private models
# pulled by sentence-transformers / transformers (reranker, NLI, tokenizers).
# HF_TOKEN=hf_...

# Optional API auth keys for protected endpoints (comma separated)
# DOC_API_KEYS=dev-key-1

# --- Team connectors (Phase 3) ---------------------------------------------
# Secrets are read from these env vars at sync time and never stored in the DB.
# A connector's config.token_env can override which var it reads.
# GITHUB_TOKEN=ghp_...            # read-only PAT for github connector
# JIRA_API_TOKEN=...             # Atlassian API token for jira connector
# CONFLUENCE_API_TOKEN=...       # Atlassian API token for confluence connector
# SLACK_BOT_TOKEN=xoxb-...       # Slack bot token (channels:history, channels:read)
# Periodic auto-sync interval in minutes (0 = disabled / manual sync only)
# CONNECTOR_SYNC_INTERVAL_MIN=0

LOG_LEVEL=INFO
