# Host vault path mounted into API container at /vault
VAULT_HOST_PATH=/Users/vamshipokala/Documents/Second-Brain

# Postgres
POSTGRES_PASSWORD=localdev
# Host port for the Postgres container (container-side stays 5432).
# Default is 5433 to avoid colliding with a local Homebrew Postgres on 5432.
POSTGRES_HOST_PORT=5433

# Vector backend
VECTOR_BACKEND=pgvector

# Ollama
OLLAMA_KEEP_ALIVE=5m
LLM_DEFAULT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Resource controls
MAX_INGEST_WORKERS=2
WATCHER_DEBOUNCE_MS=5000
# Backfill vault files added while the API was down (0=off, 1=on).
# Keep off by default on Docker Desktop/macOS — a large vault scan at boot
# can block interactive Scan & ingest for a long time.
SCAN_ON_STARTUP=0

# Provider keys (optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AI...
# GROQ_API_KEY=gsk_...

# AI Gateway / LiteLLM (OpenAI-compatible). Prefer Settings UI; env wins if set.
# GATEWAY_BASE_URL=http://localhost:4000/v1
# GATEWAY_API_KEY=sk-...
# GATEWAY_DEFAULT_MODEL=gpt-4o-mini
# BRAVE_SEARCH_API_KEY=BSA...   # Ask web search (env wins over Settings)
# VISION_INGEST_ENABLED=true   # allow PNG/JPEG/WebP ingest placeholders
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=second-brain-app
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Hugging Face access token (optional). Required only for gated/private models
# pulled by sentence-transformers / transformers (reranker, NLI, tokenizers).
# HF_TOKEN=hf_...

# Optional API auth keys for protected endpoints (comma separated)
# DOC_API_KEYS=dev-key-1

# --- Team connectors (Phase 3) ---------------------------------------------
# Secrets are read from these env vars at sync time and never stored in the DB.
# A connector's config.token_env can override which var it reads.
# GITHUB_TOKEN=ghp_...            # read-only PAT for github / mcp_github (token fallback)
# JIRA_API_TOKEN=...             # Atlassian API token for legacy jira / mcp_jira token mode
# JIRA_EMAIL=you@acme.com        # Account email for Atlassian Basic auth (MCP token mode)
# CONFLUENCE_API_TOKEN=...       # Atlassian API token for legacy confluence / mcp_confluence
# SLACK_BOT_TOKEN=xoxb-...       # Slack bot token (channels:history, channels:read)
# Periodic auto-sync interval in minutes (0 = disabled / manual sync only)
# CONNECTOR_SYNC_INTERVAL_MIN=0

# --- MCP connectors --------------------------------------------------------
# OAuth callback the browser hits after signing into Atlassian / GitHub MCP.
# MCP_OAUTH_REDIRECT_URI=http://localhost:8000/mcp/oauth/callback
# GitHub remote MCP does NOT support Dynamic Client Registration.
# Prefer a PAT (GITHUB_TOKEN) via “Use API token”. Optional browser OAuth requires
# a GitHub OAuth App with callback = MCP_OAUTH_REDIRECT_URI:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPES=repo read:org read:user user:email
#
# --- GitHub Enterprise Server / ghe.com ------------------------------------
# Web host (OAuth authorize/token endpoints). Example: https://github.company.com
# or https://acme.ghe.com
# GITHUB_HOST=
# Explicit REST API base (defaults to {GITHUB_HOST}/api/v3, or api.github.com):
# GITHUB_API_URL=https://github.company.com/api/v3
# Self-hosted github-mcp-server URL (required for GHES MCP; Copilot remote MCP
# does not support Enterprise Server):
# GITHUB_MCP_URL=http://localhost:8080/mcp
# Internal URL of the Google Workspace MCP sidecar (must be browser-reachable for OAuth).
# WORKSPACE_MCP_URL=http://host.docker.internal:8001/mcp
# Google Cloud OAuth client for workspace-mcp (Gmail + Chat Connect → Google login):
# 1) Create a Google Cloud project; enable Gmail API + Google Chat API
# 2) Create OAuth client type "Web application"
# 3) Authorized redirect URIs:
#      http://localhost:8001/oauth2callback
#      http://localhost:8000/mcp/oauth/callback
# 4) Paste client id/secret here (also used by the api container), then:
#      docker compose up -d --build
#      docker compose --profile mcp up -d workspace-mcp
# Sidecar image (official GHCR; override only if you build/mirror your own):
# WORKSPACE_MCP_IMAGE=ghcr.io/taylorwilsdon/google_workspace_mcp:latest
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/oauth2callback
# MCP_ENABLE_OAUTH21=true
# WORKSPACE_MCP_ENABLED_SERVICES=gmail,chat
# WORKSPACE_MCP_HOST_PORT=8001
# WORKSPACE_EXTERNAL_URL=http://localhost:8001

LOG_LEVEL=INFO
